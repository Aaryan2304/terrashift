# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Data and products (large)
*.SAFE/
*.zip
*.tar.gz
labels/*.tif
labels/*.geojson

# Outputs (large)
outputs/checkpoints/
outputs/**/*.pt
outputs/**/*.onnx
outputs/**/*.tif
outputs/**/*.png
outputs/**/*.jpg
outputs/**/*.geojson
outputs/**/*.csv
# Keep the small audit text files. These negations MUST come after the
# exclusion above, otherwise git applies the last matching pattern and the
# files stay ignored.
!outputs/audit/*.csv
!outputs/audit/*.json
!outputs/audit/*.md
!outputs/audit/*.txt
!outputs/**/.gitkeep

# OS and editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
