diff --git a/scripts/apply_label_exclusions.py b/scripts/apply_label_exclusions.py
new file mode 100644
index 0000000..1e743bb
--- /dev/null
+++ b/scripts/apply_label_exclusions.py
@@ -0,0 +1,114 @@
+"""Apply an exclusion manifest to a manual annotation export.
+
+Records named in the manifest are dropped from the output. The master file is
+never touched: this reads it and writes a new export. Every applied exclusion is
+reported, and the script refuses to write if an excluded ID is missing from the
+source, so a typo cannot silently pass.
+
+    python scripts/apply_label_exclusions.py \
+        --labels labels/manual_labels_A.geojson \
+        --exclusions labels/exclusions_A.json \
+        --output labels/manual_labels_A_filtered.geojson \
+        --report outputs/labels/pair_a_qa/exclusions_applied.json
+"""
+
+import argparse
+import json
+import os
+import sys
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+
+
+def load_manifest(path):
+    with open(path) as handle:
+        manifest = json.load(handle)
+    if "exclusions" not in manifest or not isinstance(manifest["exclusions"], list):
+        raise ValueError("manifest has no 'exclusions' list: %s" % path)
+    ids = [item["record_id"] for item in manifest["exclusions"]]
+    if len(ids) != len(set(ids)):
+        raise ValueError("manifest lists a record_id more than once")
+    for item in manifest["exclusions"]:
+        if not item.get("reason"):
+            raise ValueError("exclusion %s has no reason" % item.get("record_id"))
+    return manifest
+
+
+def apply_exclusions(features, manifest, pair=None):
+    """Split features into kept and excluded. Returns (kept, excluded, unknown)."""
+    wanted = {item["record_id"]: item for item in manifest["exclusions"]}
+    kept, excluded = [], []
+    seen = set()
+    for feature in features:
+        props = feature.get("properties", {})
+        if pair is not None and props.get("pair") != pair:
+            raise ValueError("feature %s belongs to pair %s, expected %s"
+                             % (props.get("record_id"), props.get("pair"), pair))
+        record_id = props.get("record_id")
+        if record_id in wanted:
+            entry = dict(wanted[record_id])
+            entry["label_class"] = props.get("label_class")
+            excluded.append(entry)
+            seen.add(record_id)
+        else:
+            kept.append(feature)
+    unknown = sorted(set(wanted) - seen)
+    return kept, excluded, unknown
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--labels", required=True)
+    parser.add_argument("--exclusions", required=True)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--report", default=None)
+    parser.add_argument("--pair", default=None, help="assert every feature is this pair")
+    args = parser.parse_args()
+
+    for path in (args.output, args.report):
+        if path and os.path.exists(path):
+            raise SystemExit("refusing to overwrite %s" % path)
+
+    manifest = load_manifest(args.exclusions)
+    with open(args.labels) as handle:
+        payload = json.load(handle)
+    if payload.get("type") != "FeatureCollection":
+        raise ValueError("input is not a GeoJSON FeatureCollection")
+
+    kept, excluded, unknown = apply_exclusions(payload["features"], manifest, args.pair)
+    if unknown:
+        raise SystemExit("exclusions reference records absent from the labels: %s"
+                         % ", ".join(unknown))
+
+    output = {"type": "FeatureCollection", "name": payload.get("name", "labels"),
+              "features": kept}
+    with open(args.output, "w") as handle:
+        json.dump(output, handle, indent=1)
+
+    report = {
+        "source": os.path.abspath(args.labels),
+        "output": os.path.abspath(args.output),
+        "input_features": len(payload["features"]),
+        "kept_features": len(kept),
+        "excluded_count": len(excluded),
+        "excluded": excluded,
+        "policy": manifest.get("policy", ""),
+    }
+    if args.report:
+        os.makedirs(os.path.dirname(os.path.abspath(args.report)), exist_ok=True)
+        with open(args.report, "w") as handle:
+            json.dump(report, handle, indent=1)
+
+    print("input %d -> kept %d, excluded %d" % (len(payload["features"]),
+                                                len(kept), len(excluded)))
+    for item in excluded:
+        print("  excluded %-6s %-14s %s" % (item["record_id"], item["reason"],
+                                            item["detail"][:70] + "..."))
+    print("wrote", args.output)
+    if args.report:
+        print("wrote", args.report)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/benchmark_validation_providers.py b/scripts/benchmark_validation_providers.py
new file mode 100644
index 0000000..e072448
--- /dev/null
+++ b/scripts/benchmark_validation_providers.py
@@ -0,0 +1,324 @@
+"""Benchmark ONNX FP32 and INT8 QDQ over the whole OSCD validation split.
+
+Three configurations, same checkpoint, same windows, same threshold, same
+evaluation code:
+
+    cuda_fp32   ONNX FP32 on CUDAExecutionProvider
+    cuda_int8   ONNX INT8 QDQ on CUDAExecutionProvider
+    cpu_int8    ONNX INT8 QDQ on CPUExecutionProvider, the reference
+
+CUDAExecutionProvider is required, not requested: ``create_session`` raises if
+it was dropped, so a silent CPU fallback cannot produce a number here.
+
+The validation split only. The official test split is never opened by this
+script; ``make_dataset(..., "validation", ...)`` is the only split requested.
+
+Outputs go to a fresh directory and are never overwritten.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import threading
+import time
+
+import numpy as np
+import onnxruntime as ort
+import torch
+import yaml
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+
+from quantize import evaluate_ort, load_model, make_dataset
+from utils.ort_session import CPU, CUDA, create_session, optimisation_label
+
+# CPU QDQ sessions are pinned below the QLinearConv fusion that corrupts this
+# model (docs/decisions/009-cpu-qdq-optimiser-defect.md). CUDA keeps the default
+# level, which is numerically identical to its own unoptimised path.
+CPU_QDQ_OPTIMISATION = ort.GraphOptimizationLevel.ORT_ENABLE_BASIC
+CUDA_OPTIMISATION = ort.GraphOptimizationLevel.ORT_ENABLE_ALL
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        for block in iter(lambda: handle.read(1 << 20), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def gpu_memory_used_mib():
+    """Memory in use on GPU 0, from nvidia-smi. None when it is unavailable."""
+    try:
+        result = subprocess.run(
+            ["nvidia-smi", "--query-gpu=memory.used", "--format=csv,noheader,nounits"],
+            capture_output=True, text=True, timeout=10)
+        return float(result.stdout.strip().splitlines()[0])
+    except (OSError, subprocess.SubprocessError, IndexError, ValueError):
+        return None
+
+
+class MemorySampler(threading.Thread):
+    """Sample GPU memory in the background and keep the peak."""
+
+    def __init__(self, interval_s=0.05):
+        super().__init__(daemon=True)
+        self.interval_s = interval_s
+        self.peak_mib = 0.0
+        self.baseline_mib = gpu_memory_used_mib() or 0.0
+        self._stop_event = threading.Event()
+
+    def run(self):
+        while not self._stop_event.is_set():
+            used = gpu_memory_used_mib()
+            if used is not None:
+                self.peak_mib = max(self.peak_mib, used)
+            self._stop_event.wait(self.interval_s)
+
+    def stop(self):
+        self._stop_event.set()
+        self.join(timeout=2.0)
+
+
+def run_pass(session, loader, input_names, timed=False):
+    """One pass over the loader. Returns per-batch seconds when timed."""
+    durations = []
+    for batch in loader:
+        feed = {input_names[0]: batch["image1"].numpy().astype(np.float32),
+                input_names[1]: batch["image2"].numpy().astype(np.float32)}
+        start = time.perf_counter()
+        session.run(None, feed)
+        if timed:
+            durations.append(time.perf_counter() - start)
+    return durations
+
+
+def partition_report(model_path, providers, loader, input_names, label):
+    """Kernel placements and CPU boundary count, from ORT profiling events."""
+    options = ort.SessionOptions()
+    options.enable_profiling = True
+    session, active = create_session(model_path, providers,
+                                     sess_options=options, require=providers[0],
+                                     preload_cuda=True,
+                                     optimization_level=CUDA_OPTIMISATION)
+    batch = next(iter(loader))
+    session.run(None, {input_names[0]: batch["image1"].numpy().astype(np.float32),
+                       input_names[1]: batch["image2"].numpy().astype(np.float32)})
+    profile_path = session.end_profiling()
+    with open(profile_path) as handle:
+        events = json.load(handle)
+    os.unlink(profile_path)
+
+    counts = {}
+    memcpy_nodes = 0
+    for event in events:
+        args = event.get("args") or {}
+        provider = args.get("provider")
+        if not provider:
+            continue
+        counts[provider] = counts.get(provider, 0) + 1
+        if "Memcpy" in str(event.get("name", "")):
+            memcpy_nodes += 1
+    total = sum(counts.values())
+    return {
+        "label": label,
+        "active_providers": active,
+        "kernel_launches": counts,
+        "total_kernel_launches": total,
+        "cuda_fraction": counts.get(CUDA, 0) / total if total else 0.0,
+        "cpu_memcpy_kernel_events": memcpy_nodes,
+    }
+
+
+def summarise(durations, windows):
+    array = np.asarray(durations, dtype=np.float64) * 1000.0     # ms per batch
+    per_window = array / windows
+    return {
+        "batches": int(array.size),
+        "batch_ms_median": float(np.median(array)),
+        "batch_ms_p95": float(np.percentile(array, 95)),
+        "batch_ms_min": float(array.min()),
+        "batch_ms_max": float(array.max()),
+        "window_ms_median": float(np.median(per_window)),
+        "windows_per_second": float(windows / (array.sum() / array.size / 1000.0)),
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--checkpoint", required=True)
+    parser.add_argument("--quant-dir", required=True,
+                        help="directory holding onboard_fp32.onnx and onboard_int8.onnx")
+    parser.add_argument("--output-dir", required=True)
+    parser.add_argument("--config", default=os.path.join(ROOT, "config.yaml"))
+    parser.add_argument("--batch-size", type=int, default=8)
+    parser.add_argument("--warmup", type=int, default=2, help="warm-up passes")
+    parser.add_argument("--runs", type=int, default=3, help="timed passes")
+    args = parser.parse_args()
+
+    output_dir = os.path.join(ROOT, args.output_dir)
+    json_path = os.path.join(output_dir, "validation_benchmark.json")
+    md_path = os.path.join(output_dir, "validation_benchmark.md")
+    for path in (json_path, md_path):
+        if os.path.exists(path):
+            parser.error("refusing to overwrite %s" % path)
+
+    fp32_path = os.path.join(ROOT, args.quant_dir, "onboard_fp32.onnx")
+    int8_path = os.path.join(ROOT, args.quant_dir, "onboard_int8.onnx")
+    for path in (fp32_path, int8_path):
+        if not os.path.isfile(path):
+            parser.error("model not found: %s" % path)
+
+    with open(args.config) as handle:
+        cfg = yaml.safe_load(handle)
+    threshold = float(cfg["evaluation"]["threshold"])
+
+    _, bands, checkpoint = load_model(args.checkpoint, torch.device("cpu"))
+    loader = make_dataset(cfg, "validation", checkpoint, args.batch_size)
+    windows = len(loader.dataset)
+    input_names = [item.name for item in
+                   create_session(fp32_path, [CPU])[0].get_inputs()]
+    print("validation windows", windows, "batch", args.batch_size,
+          "threshold", threshold, "bands", bands)
+
+    report = {
+        "checkpoint": os.path.abspath(args.checkpoint),
+        "checkpoint_sha256": sha256(args.checkpoint),
+        "models": {
+            "fp32": {"path": fp32_path, "sha256": sha256(fp32_path),
+                     "size_bytes": os.path.getsize(fp32_path)},
+            "int8": {"path": int8_path, "sha256": sha256(int8_path),
+                     "size_bytes": os.path.getsize(int8_path)},
+        },
+        "split": "validation",
+        "official_test_accessed": False,
+        "windows": windows,
+        "batch_size": args.batch_size,
+        "threshold": threshold,
+        "band_order": bands,
+        "warmup_passes": args.warmup,
+        "timed_passes": args.runs,
+        "available_providers": ort.get_available_providers(),
+        "status": "measured_development_result",
+        "runs": {},
+    }
+
+    configurations = [
+        ("cuda_fp32", fp32_path, [CUDA, CPU], True, CUDA_OPTIMISATION),
+        ("cuda_int8", int8_path, [CUDA, CPU], True, CUDA_OPTIMISATION),
+        ("cpu_int8", int8_path, [CPU], False, CPU_QDQ_OPTIMISATION),
+    ]
+
+    for name, model_path, providers, uses_gpu, level in configurations:
+        print("\n===", name)
+        session, active = create_session(model_path, providers, require=providers[0],
+                                         preload_cuda=uses_gpu,
+                                         optimization_level=level)
+        print("   providers:", active, "optimisation:", optimisation_label(level))
+
+        sampler = MemorySampler() if uses_gpu else None
+        if sampler:
+            sampler.start()
+
+        for _ in range(args.warmup):
+            run_pass(session, loader, input_names)
+        durations = []
+        for _ in range(args.runs):
+            durations.extend(run_pass(session, loader, input_names, timed=True))
+
+        if sampler:
+            sampler.stop()
+
+        metrics, _ = evaluate_ort(session, loader, input_names, threshold)
+        entry = {
+            "model": os.path.basename(model_path),
+            "active_providers": active,
+            "optimisation": optimisation_label(level),
+            "cuda_required": uses_gpu,
+            "metrics": {k: metrics[k] for k in
+                        ("ap", "auc", "precision", "recall", "f1", "iou",
+                         "tp", "fp", "fn", "tn")},
+            "latency": summarise(durations, args.batch_size),
+        }
+        if sampler:
+            entry["gpu_memory"] = {
+                "baseline_mib": sampler.baseline_mib,
+                "peak_mib": sampler.peak_mib,
+                "delta_mib": sampler.peak_mib - sampler.baseline_mib,
+            }
+        report["runs"][name] = entry
+        print("   AP %.4f AUC %.4f F1 %.4f  median %.2f ms/batch  %.1f win/s"
+              % (metrics["ap"], metrics["auc"], metrics["f1"],
+                 entry["latency"]["batch_ms_median"],
+                 entry["latency"]["windows_per_second"]))
+        if sampler:
+            print("   GPU peak %.0f MiB (delta %.0f)"
+                  % (entry["gpu_memory"]["peak_mib"], entry["gpu_memory"]["delta_mib"]))
+
+    report["partitioning"] = {
+        "cuda_fp32": partition_report(fp32_path, [CUDA, CPU], loader, input_names,
+                                      "cuda_fp32"),
+        "cuda_int8": partition_report(int8_path, [CUDA, CPU], loader, input_names,
+                                      "cuda_int8"),
+    }
+
+    os.makedirs(output_dir, exist_ok=True)
+    with open(json_path, "w") as handle:
+        json.dump(report, handle, indent=2)
+
+    lines = [
+        "# Validation benchmark: ONNX FP32 and INT8 across providers",
+        "",
+        "Checkpoint `%s`, sha256 `%s`." % (report["checkpoint"],
+                                           report["checkpoint_sha256"][:16]),
+        "Validation split only: %d windows, batch %d, threshold %.2f."
+        % (windows, args.batch_size, threshold),
+        "The official OSCD test split was not opened.",
+        "",
+        "| Run | Providers | Optimisation | AP | AUC | Precision | Recall | F1 |",
+        "|---|---|---|---|---|---|---|---|",
+    ]
+    for name in ("cuda_fp32", "cuda_int8", "cpu_int8"):
+        entry = report["runs"][name]
+        metric = entry["metrics"]
+        lines.append("| %s | %s | %s | %.4f | %.4f | %.4f | %.4f | %.4f |"
+                     % (name, " + ".join(p.replace("ExecutionProvider", "")
+                                         for p in entry["active_providers"]),
+                        entry["optimisation"],
+                        metric["ap"], metric["auc"], metric["precision"],
+                        metric["recall"], metric["f1"]))
+    lines += ["", "## Latency", "",
+              "| Run | Median ms/batch | p95 ms/batch | Median ms/window | Windows/s |",
+              "|---|---|---|---|---|"]
+    for name in ("cuda_fp32", "cuda_int8", "cpu_int8"):
+        latency = report["runs"][name]["latency"]
+        lines.append("| %s | %.2f | %.2f | %.2f | %.1f |"
+                     % (name, latency["batch_ms_median"], latency["batch_ms_p95"],
+                        latency["window_ms_median"], latency["windows_per_second"]))
+    lines += ["", "## Memory and placement", "",
+              "| Run | GPU peak MiB | Delta MiB | CUDA kernels | CPU kernels | CPU Memcpy events |",
+              "|---|---|---|---|---|---|"]
+    for name in ("cuda_fp32", "cuda_int8"):
+        entry = report["runs"][name]
+        part = report["partitioning"][name]
+        memory = entry.get("gpu_memory", {})
+        lines.append("| %s | %.0f | %.0f | %d (%.1f %%) | %d | %d |"
+                     % (name, memory.get("peak_mib", 0), memory.get("delta_mib", 0),
+                        part["kernel_launches"].get(CUDA, 0),
+                        100.0 * part["cuda_fraction"],
+                        part["kernel_launches"].get(CPU, 0),
+                        part["cpu_memcpy_kernel_events"]))
+    lines += ["", "`cpu_int8` is the reference: no GPU memory, CPU provider only.", ""]
+    with open(md_path, "w") as handle:
+        handle.write("\n".join(lines))
+
+    print("\nwrote", json_path)
+    print("wrote", md_path)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/build_calibration_shortlist.py b/scripts/build_calibration_shortlist.py
new file mode 100644
index 0000000..4f43783
--- /dev/null
+++ b/scripts/build_calibration_shortlist.py
@@ -0,0 +1,336 @@
+"""Choose a 10-candidate calibration shortlist and write a review sheet.
+
+Selection is diversity-first, not score-first:
+
+1. only candidates in a ``train`` partition and clear of the guard band;
+2. five size targets per pair, at the minimum, 25th, 50th, 75th and maximum
+   component area, so the shortlist spans the whole size range instead of
+   clustering in the most populated band;
+3. at each target, look at the candidates nearest that target by area and take
+   the one farthest from the ones already chosen, so the ten are spread across
+   the imagery;
+4. score never enters the ranking. It is measured afterwards and reported, so
+   the spread can be checked rather than engineered.
+
+Land-cover context comes from the water mask: the land, stable-water and
+shoreline fractions within 1 km of the centroid. Navigation order is a greedy
+nearest-neighbour tour, so panning between candidates is short.
+
+Nothing is labelled here. The review sheet is written with empty decision
+columns.
+"""
+
+import argparse
+import csv
+import json
+import math
+import os
+import sys
+
+import numpy as np
+import rasterio
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+
+QUEUE = os.path.join(ROOT, "review", "manual_review_v1", "review_queue.csv")
+WATER_DIR = os.path.join(ROOT, "outputs", "audit")
+DEFAULT_OUT = os.path.join(ROOT, "review", "calibration_v1")
+
+PER_PAIR = 5
+STRATA = 5
+CONTEXT_RADIUS_PX = 50          # 1 km on the 20 m grid
+WATER_INVALID, WATER_LAND, WATER_STABLE, WATER_SHORE = 0, 1, 2, 3
+
+SHORTLIST_FIELDS = [
+    "nav_order", "candidate_id", "pair", "partition", "size_rank",
+    "centroid_lon", "centroid_lat", "centroid_easting", "centroid_northing",
+    "bbox_width_m", "bbox_height_m", "bbox_area_m2",
+    "component_area_px_20m", "component_area_m2",
+    "mean_score", "max_score",
+    "land_fraction_1km", "water_fraction_1km", "shoreline_fraction_1km",
+    "context_class", "nearest_train_candidate_m", "selection_reason",
+]
+
+SHEET_FIELDS = [
+    "nav_order", "candidate_id", "pair", "partition", "centroid_lon", "centroid_lat",
+    "bbox_width_m", "bbox_height_m", "component_area_m2", "max_score",
+    "interpretability", "apparent_class", "suitable_for_polygon",
+    "reason", "evidence", "notes",
+]
+
+
+def load_queue(path):
+    with open(path, newline="") as handle:
+        rows = list(csv.DictReader(handle))
+    for row in rows:
+        row["component_area_px_20m"] = int(row["component_area_px_20m"])
+        row["component_area_m2"] = float(row["component_area_m2"])
+        row["bbox_width_m"] = float(row["bbox_width_m"])
+        row["bbox_height_m"] = float(row["bbox_height_m"])
+        row["bbox_area_m2"] = float(row["bbox_area_m2"])
+        row["mean_score"] = float(row["mean_score"])
+        row["max_score"] = float(row["max_score"])
+        row["centroid_easting"] = float(row["centroid_easting"])
+        row["centroid_northing"] = float(row["centroid_northing"])
+        row["centroid_lon"] = float(row["centroid_lon"])
+        row["centroid_lat"] = float(row["centroid_lat"])
+    return rows
+
+
+def context_fractions(dataset, easting, northing, radius_px=CONTEXT_RADIUS_PX):
+    """Land, water and shoreline fractions within a window around a point."""
+    col, row = ~dataset.transform * (easting, northing)
+    col, row = int(round(col)), int(round(row))
+    col0 = max(0, col - radius_px)
+    row0 = max(0, row - radius_px)
+    col1 = min(dataset.width, col + radius_px)
+    row1 = min(dataset.height, row + radius_px)
+    if col1 <= col0 or row1 <= row0:
+        return None
+    window = dataset.read(1, window=((row0, row1), (col0, col1)))
+    total = window.size
+    if total == 0:
+        return None
+    land = float((window == WATER_LAND).sum()) / total
+    water = float((window == WATER_STABLE).sum()) / total
+    shore = float((window == WATER_SHORE).sum()) / total
+    return {"land": land, "water": water, "shoreline": shore,
+            "context_class": context_class(land, water, shore)}
+
+
+def context_class(land, water, shore):
+    """A coarse land-cover label for review variety, not a land-use map."""
+    if water >= 0.5:
+        return "water_dominated"
+    if shore >= 0.10:
+        return "coastal_margin"
+    if water >= 0.10:
+        return "mixed_inland_water"
+    return "inland"
+
+
+def annotate_context(rows, water_dir):
+    for pair in ("A", "B"):
+        path = os.path.join(water_dir, "water_masks_%s.tif" % pair)
+        with rasterio.open(path) as dataset:
+            for row in rows:
+                if row["pair"] != pair:
+                    continue
+                fractions = context_fractions(dataset, row["centroid_easting"],
+                                              row["centroid_northing"])
+                if fractions is None:
+                    row["land_fraction_1km"] = row["water_fraction_1km"] = ""
+                    row["shoreline_fraction_1km"] = ""
+                    row["context_class"] = "unknown"
+                    continue
+                row["land_fraction_1km"] = round(fractions["land"], 3)
+                row["water_fraction_1km"] = round(fractions["water"], 3)
+                row["shoreline_fraction_1km"] = round(fractions["shoreline"], 3)
+                row["context_class"] = fractions["context_class"]
+    return rows
+
+
+def distance_m(row_a, row_b):
+    return math.hypot(row_a["centroid_easting"] - row_b["centroid_easting"],
+                      row_a["centroid_northing"] - row_b["centroid_northing"])
+
+
+def nearest_train_distance(row, rows):
+    others = [distance_m(row, other) for other in rows if other is not row]
+    return min(others) if others else float("nan")
+
+
+def strata_by_area(rows, strata=STRATA):
+    """Five groups of near-equal size, ordered smallest to largest area."""
+    ordered = sorted(rows, key=lambda r: (r["component_area_px_20m"],
+                                          r["candidate_id"]))
+    groups = []
+    for index in range(strata):
+        start = round(index * len(ordered) / strata)
+        stop = round((index + 1) * len(ordered) / strata)
+        groups.append(ordered[start:stop])
+    return [group for group in groups if group]
+
+
+def size_targets(rows, per_pair=PER_PAIR):
+    """Component-area targets spanning the smallest to the largest candidate."""
+    areas = np.array([row["component_area_px_20m"] for row in rows], dtype=float)
+    if areas.size <= per_pair:
+        return sorted(areas.tolist())
+    percentiles = np.linspace(0, 100, per_pair)
+    return [float(np.percentile(areas, p)) for p in percentiles]
+
+
+def select(rows, per_pair=PER_PAIR, neighbours=5):
+    """Diversity-first selection: size targets, then farthest-point inside each."""
+    chosen = []
+    targets = size_targets(rows, per_pair)
+    for index, target in enumerate(targets, start=1):
+        # The two extreme targets take the candidate closest to the extreme, so
+        # the shortlist really contains the smallest and the largest. Middle
+        # targets look at a few candidates and pick for spatial spread instead.
+        window = 1 if index in (1, len(targets)) else neighbours
+        nearest_by_area = sorted(
+            rows, key=lambda r: (abs(r["component_area_px_20m"] - target),
+                                 r["candidate_id"]))[:window]
+        if chosen:
+            scored = [(min(distance_m(candidate, other) for other in chosen), candidate)
+                      for candidate in nearest_by_area]
+        else:
+            # Nothing selected yet: prefer the most isolated candidate overall, so
+            # the tour does not start inside a cluster.
+            scored = [(nearest_train_distance(candidate, rows), candidate)
+                      for candidate in nearest_by_area]
+        scored.sort(key=lambda item: (-item[0], item[1]["candidate_id"]))
+        spread, pick = scored[0]
+        pick["area_stratum"] = index
+        pick["selection_reason"] = (
+            "size target %d/%d at %d px: closest candidates by area, took the one "
+            "%.0f m from the nearest of those already selected"
+            % (index, len(targets), round(target), spread))
+        chosen.append(pick)
+    return chosen
+
+
+def navigation_order(rows):
+    """Greedy nearest-neighbour tour starting from the westernmost candidate."""
+    if not rows:
+        return []
+    remaining = list(rows)
+    current = min(remaining, key=lambda r: (r["centroid_easting"], r["candidate_id"]))
+    order = [current]
+    remaining.remove(current)
+    while remaining:
+        current = min(remaining, key=lambda r: (distance_m(order[-1], r),
+                                                r["candidate_id"]))
+        order.append(current)
+        remaining.remove(current)
+    return order
+
+
+def shortlist_rows(rows):
+    out = []
+    for row in rows:
+        out.append({
+            "nav_order": row["nav_order"],
+            "candidate_id": row["candidate_id"],
+            "pair": row["pair"],
+            "partition": row["partition"],
+            "size_rank": row["area_stratum"],
+            "centroid_lon": row["centroid_lon"],
+            "centroid_lat": row["centroid_lat"],
+            "centroid_easting": row["centroid_easting"],
+            "centroid_northing": row["centroid_northing"],
+            "bbox_width_m": row["bbox_width_m"],
+            "bbox_height_m": row["bbox_height_m"],
+            "bbox_area_m2": row["bbox_area_m2"],
+            "component_area_px_20m": row["component_area_px_20m"],
+            "component_area_m2": row["component_area_m2"],
+            "mean_score": row["mean_score"],
+            "max_score": row["max_score"],
+            "land_fraction_1km": row["land_fraction_1km"],
+            "water_fraction_1km": row["water_fraction_1km"],
+            "shoreline_fraction_1km": row["shoreline_fraction_1km"],
+            "context_class": row["context_class"],
+            "nearest_train_candidate_m": round(nearest_train_distance(row, rows), 1)
+            if len(rows) > 1 else "",
+            "selection_reason": row["selection_reason"],
+        })
+    return out
+
+
+def sheet_rows(rows):
+    out = []
+    for row in rows:
+        out.append({
+            "nav_order": row["nav_order"],
+            "candidate_id": row["candidate_id"],
+            "pair": row["pair"],
+            "partition": row["partition"],
+            "centroid_lon": row["centroid_lon"],
+            "centroid_lat": row["centroid_lat"],
+            "bbox_width_m": row["bbox_width_m"],
+            "bbox_height_m": row["bbox_height_m"],
+            "component_area_m2": row["component_area_m2"],
+            "max_score": row["max_score"],
+            "interpretability": "",
+            "apparent_class": "",
+            "suitable_for_polygon": "",
+            "reason": "",
+            "evidence": "",
+            "notes": "",
+        })
+    return out
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--queue", default=QUEUE)
+    parser.add_argument("--water-dir", default=WATER_DIR)
+    parser.add_argument("--output-dir", default=DEFAULT_OUT)
+    args = parser.parse_args()
+
+    shortlist_path = os.path.join(args.output_dir, "calibration_shortlist.csv")
+    sheet_path = os.path.join(args.output_dir, "review_sheet.csv")
+    json_path = os.path.join(args.output_dir, "calibration_summary.json")
+    for path in (shortlist_path, sheet_path, json_path):
+        if os.path.exists(path):
+            parser.error("refusing to overwrite %s" % path)
+
+    rows = load_queue(args.queue)
+    eligible = [row for row in rows
+                if row["partition"] == "train" and row["touches_guard_band"] != "True"]
+    annotate_context(eligible, args.water_dir)
+    print("eligible train candidates:", len(eligible))
+
+    chosen = []
+    nav = 0
+    for pair in ("A", "B"):
+        pool = [row for row in eligible if row["pair"] == pair]
+        picked = select(pool)
+        for row in navigation_order(picked):
+            nav += 1
+            row["nav_order"] = nav
+            chosen.append(row)
+        print("%s: %d selected, area %d-%d px, max_score %.3f-%.3f, contexts %s"
+              % (pair, len(picked),
+                 min(r["component_area_px_20m"] for r in picked),
+                 max(r["component_area_px_20m"] for r in picked),
+                 min(r["max_score"] for r in picked),
+                 max(r["max_score"] for r in picked),
+                 sorted({r["context_class"] for r in picked})))
+
+    os.makedirs(args.output_dir, exist_ok=True)
+    with open(shortlist_path, "w", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=SHORTLIST_FIELDS)
+        writer.writeheader()
+        writer.writerows(shortlist_rows(chosen))
+    with open(sheet_path, "w", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=SHEET_FIELDS)
+        writer.writeheader()
+        writer.writerows(sheet_rows(chosen))
+
+    summary = {
+        "candidates": len(chosen),
+        "eligible_train_candidates": len(eligible),
+        "per_pair": PER_PAIR,
+        "strata_per_pair": STRATA,
+        "context_radius_m": CONTEXT_RADIUS_PX * 20,
+        "selected": [{"nav_order": r["nav_order"], "candidate_id": r["candidate_id"],
+                      "pair": r["pair"], "area_px": r["component_area_px_20m"],
+                      "max_score": r["max_score"], "context": r["context_class"]}
+                     for r in chosen],
+        "status": "calibration_shortlist_not_labels",
+        "decisions_recorded": False,
+    }
+    with open(json_path, "w") as handle:
+        json.dump(summary, handle, indent=1)
+
+    print("\nwrote", shortlist_path)
+    print("wrote", sheet_path)
+    print("wrote", json_path)
+
+
+if __name__ == "__main__":
+    main()
