new file mode 100644
index 0000000..0ba6991
--- /dev/null
+++ b/utils/imagery.py
@@ -0,0 +1,37 @@
+"""RGB rendering helpers shared by the review figures.
+
+The stretch is computed once from a subsample of both dates and then applied to
+both, so the two panels are directly comparable. A per-panel stretch would
+hide a real brightness change between the dates.
+"""
+
+import numpy as np
+
+RGB_BANDS = ("B04", "B03", "B02")
+
+
+def rgb(product, shape):
+    """True-colour RGB stack in red=B04, green=B03, blue=B02 order."""
+    return np.stack([product.read_band(b, out_shape=shape)[0]
+                     for b in RGB_BANDS], axis=-1)
+
+
+def stretch_pair(first, second):
+    """Apply one shared 2-98 percentile stretch to both RGB images."""
+    limits = []
+    for band in range(3):
+        sample = np.concatenate([first[::8, ::8, band].ravel(),
+                                 second[::8, ::8, band].ravel()])
+        sample = sample[np.isfinite(sample)]
+        if sample.size == 0:
+            raise ValueError("no finite pixels to stretch")
+        limits.append(np.percentile(sample, [2, 98]))
+
+    def apply(image):
+        out = np.zeros_like(image, dtype=np.float32)
+        for band, (low, high) in enumerate(limits):
+            out[..., band] = np.clip((image[..., band] - low) / max(high - low, 1e-9),
+                                     0.0, 1.0)
+        return np.nan_to_num(out)
+
+    return apply(first), apply(second)
diff --git a/utils/ort_session.py b/utils/ort_session.py
new file mode 100644
index 0000000..5a053fa
--- /dev/null
+++ b/utils/ort_session.py
@@ -0,0 +1,100 @@
+"""ONNX Runtime session construction with explicit provider verification.
+
+ONNX Runtime does not load the CUDA libraries itself. If they are missing from
+the process, it drops the requested execution provider, logs one error line, and
+builds a CPU-only session. Inference then runs, silently, at CPU speed. That
+failure mode is worse than a crash because a benchmark or an onboard deployment
+records a plausible wrong number.
+
+Two habits prevent it:
+
+1. ``preload_cuda_libraries()`` before the first session, when the process has
+   not already loaded CUDA through another framework. ``onnxruntime.preload_dlls``
+   loads CUDA 12 and cuDNN 9 from the ``nvidia-*`` site packages, so PyTorch does
+   not have to be imported to get a GPU session.
+2. ``create_session(..., require=...)``, which raises when the provider the
+   caller asked for is not in the session that was actually built.
+"""
+
+import onnxruntime as ort
+
+CUDA = "CUDAExecutionProvider"
+CPU = "CPUExecutionProvider"
+
+
+def preload_cuda_libraries(directory=None):
+    """Load the CUDA and cuDNN libraries ONNX Runtime does not load itself.
+
+    Returns True when the preload call exists and was made, False when this
+    ONNX Runtime build has no ``preload_dlls``. The call is safe to repeat.
+    """
+    preload = getattr(ort, "preload_dlls", None)
+    if preload is None:
+        return False
+    if directory is None:
+        preload()
+    else:
+        preload(directory=directory)
+    return True
+
+
+def require_provider(active, required):
+    """Raise when a requested execution provider is not in the session.
+
+    ``active`` is ``session.get_providers()``. The message names the provider,
+    what did run instead, and the usual cause, because the log line that ONNX
+    Runtime emits is easy to miss.
+    """
+    if required in active:
+        return
+    raise RuntimeError(
+        "requested execution provider %r is not active; the session was built "
+        "with %r. ONNX Runtime drops a provider silently when its libraries are "
+        "missing, so any timing or accuracy figure from this session would be a "
+        "CPU result mislabelled as GPU. Call preload_cuda_libraries() first, or "
+        "import torch before creating the session."
+        % (required, list(active)))
+
+
+def create_session(model_path, providers, sess_options=None, require=None,
+                   preload_cuda=False, directory=None, optimization_level=None):
+    """Build a session and verify the providers it actually got.
+
+    Returns ``(session, active_providers)``. Pass ``require`` to fail loudly
+    instead of accepting a silent fallback, and ``optimization_level`` to pin the
+    graph optimiser.
+
+    Pinning matters for QDQ models on CPU: ORT 1.24.4's QDQ selector fuses Conv
+    into QLinearConv at ORT_ENABLE_EXTENDED and above, and that fusion produces
+    wrong output when a convolution's bias quantisation does not satisfy the
+    ONNX QLinearConv invariant ``bias_scale == x_scale * w_scale``. See upstream
+    issue 24711 and the fix in PR 28229, and
+    ``docs/decisions/009-cpu-qdq-optimiser-defect.md`` here. Models quantised
+    from a shared Siamese bias hit this.
+    """
+    if preload_cuda:
+        preload_cuda_libraries(directory)
+    options = sess_options
+    if options is None:
+        options = ort.SessionOptions()
+    if optimization_level is not None:
+        options.graph_optimization_level = optimization_level
+    session = ort.InferenceSession(str(model_path), sess_options=options,
+                                   providers=list(providers))
+    active = list(session.get_providers())
+    if require is not None:
+        require_provider(active, require)
+    return session, active
+
+
+OPTIMISATION_LABELS = {
+    ort.GraphOptimizationLevel.ORT_DISABLE_ALL: "ORT_DISABLE_ALL",
+    ort.GraphOptimizationLevel.ORT_ENABLE_BASIC: "ORT_ENABLE_BASIC",
+    ort.GraphOptimizationLevel.ORT_ENABLE_EXTENDED: "ORT_ENABLE_EXTENDED",
+    ort.GraphOptimizationLevel.ORT_ENABLE_ALL: "ORT_ENABLE_ALL",
+}
+
+
+def optimisation_label(level):
+    """Readable name for a graph optimisation level, for reports."""
+    return OPTIMISATION_LABELS.get(level, str(level))
diff --git a/utils/unique_metrics.py b/utils/unique_metrics.py
new file mode 100644
index 0000000..6269a38
--- /dev/null
+++ b/utils/unique_metrics.py
@@ -0,0 +1,325 @@
+"""Unique-geographic-pixel statistics and validation metrics.
+
+The local patch index uses 256 px patches with stride 128, so neighbouring
+patches overlap by 50 % and a labelled pixel appears in up to four patches.
+That overlap helps training (more context, smoother gradients) but it must not
+turn one reviewed pixel into four independent validation observations, and it
+must not give one pixel four votes in the class balance or in the band
+statistics.
+
+Two exact corrections live here.
+
+``coverage_1d``
+    For every coordinate, how many patch windows cover it. The product of the
+    row and column counts is the multiplicity of a pixel. Dividing a patch's
+    contribution by that multiplicity makes a weighted sum equal the sum over
+    unique pixels, so mean, standard deviation and class counts are computed
+    once per pixel with no full-tile accumulator.
+
+``UniqueValidationAccumulator``
+    Stitches patch probabilities onto the pair grid and averages the
+    overlapping predictions, the aggregation rule documented in
+    ``docs/manual_labeling.md``. Every reviewed pixel is then scored exactly
+    once, so AP, AUC, F1 and IoU see an independent sample, not a
+    patch-weighted one.
+
+Exactness note for the weighted statistics: the multiplicity is computed from
+the patch layout, not from per-pixel validity. The weighted sums are exact when
+a pixel has the same validity in every patch that covers it, which holds
+except where band finiteness differs between patch halos at the tile border.
+``weighted_training_statistics`` reports both the weighted unique count and the
+raw patch count so the duplication factor is visible, and it reports how far
+the weighted unique count is from an integer, which is zero for exact
+weighting.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+import rasterio
+from rasterio.windows import Window
+
+from utils.metrics import average_precision, metrics_from_counts, roc_auc
+
+
+def coverage_1d(origins, patch_size, length):
+    """How many patch windows cover each coordinate of one axis.
+
+    Parameters
+    ----------
+    origins : sequence of int
+        Window start positions, as returned by ``patch_origins``.
+    patch_size : int
+    length : int
+
+    Returns
+    -------
+    numpy.ndarray, int64, shape ``(length,)``
+        Zero means no patch covers that coordinate.
+    """
+    counts = np.zeros(int(length), dtype=np.int64)
+    for origin in origins:
+        start = int(origin)
+        stop = min(start + int(patch_size), int(length))
+        if start < 0 or start >= stop:
+            raise ValueError("patch origin %d is outside the axis" % start)
+        counts[start:stop] += 1
+    return counts
+
+
+def _axis_slices(origin, size):
+    return slice(int(origin), int(origin) + int(size))
+
+
+def weighted_training_statistics(dataset):
+    """Band statistics and class counts over unique training pixels.
+
+    Parameters
+    ----------
+    dataset : data.local_patches.LocalManualPatchDataset
+        A dataset for the ``train`` split with ``mean=None`` so the values are
+        raw reflectance, not standardised.
+
+    Returns
+    -------
+    dict with ``mean``, ``std`` (float32, one value per band, pooled over both
+    dates), ``positive`` and ``negative`` (weighted pixel counts),
+    ``unique_pixels``, ``patch_pixels`` and ``weighting_rounding_error``.
+
+    The mean and standard deviation pool date 1 and date 2, which is what the
+    trainer applies to both dates.
+    """
+    if getattr(dataset, "split", None) != "train":
+        raise ValueError("training statistics require the train split")
+
+    sizes = {int(r["height"]) for r in dataset.rows}
+    if len(sizes) != 1:
+        raise ValueError("all patches must share one height for coverage weighting")
+    size = sizes.pop()
+
+    # Multiplicity at (row, col) is the number of distinct row origins that
+    # cover the row times the number of distinct column origins that cover the
+    # column. Counting patch occurrences instead would multiply by the number
+    # of patches on the other axis.
+    height = max(int(r["row_off"]) + size for r in dataset.rows)
+    width = max(int(r["col_off"]) + size for r in dataset.rows)
+    row_counts = coverage_1d(sorted({int(r["row_off"]) for r in dataset.rows}),
+                             size, height)
+    col_counts = coverage_1d(sorted({int(r["col_off"]) for r in dataset.rows}),
+                             size, width)
+    if np.any(row_counts <= 0) or np.any(col_counts <= 0):
+        raise ValueError("patch origins leave a gap; coverage weighting is undefined")
+
+    n_bands = len(dataset.bands)
+    sums = np.zeros(n_bands, dtype=np.float64)
+    squares = np.zeros(n_bands, dtype=np.float64)
+    total = 0.0
+    patch_pixels = 0
+    positive = 0.0
+    negative = 0.0
+
+    for index in range(len(dataset)):
+        sample = dataset[index]
+        row = dataset.rows[index]
+        r0 = int(row["row_off"])
+        c0 = int(row["col_off"])
+        weight = 1.0 / np.outer(row_counts[r0:r0 + size], col_counts[c0:c0 + size])
+        valid = sample["valid_mask"].numpy().astype(bool)
+        weights = weight[valid]
+        patch_pixels += int(valid.sum())
+        total += float(weights.sum())
+
+        for key in ("image1", "image2"):
+            image = sample[key].numpy()
+            for band in range(n_bands):
+                values = image[band][valid].astype(np.float64)
+                sums[band] += float((values * weights).sum())
+                squares[band] += float(((values * values) * weights).sum())
+
+        labels = sample["mask"].numpy()[valid]
+        positive += float(weights[labels == 1].sum())
+        negative += float(weights[labels == 0].sum())
+
+    if total <= 0:
+        raise ValueError("training annotations contain no valid pixels")
+
+    # The trainer applies one mean and one std to both dates, so the band
+    # statistic pools date 1 and date 2. Each date contributes one value per
+    # unique pixel, hence the factor of two.
+    pooled = total * 2.0
+    mean = sums / pooled
+    variance = squares / pooled - mean * mean
+    std = np.sqrt(np.maximum(variance, 1e-12))
+    return {
+        "mean": mean.astype(np.float32),
+        "std": std.astype(np.float32),
+        "positive": positive,
+        "negative": negative,
+        "unique_pixels": total,
+        "pooled_values": pooled,
+        "patch_pixels": patch_pixels,
+        "weighting_rounding_error": abs(total - round(total)),
+        "bands": tuple(dataset.bands),
+    }
+
+
+class UniqueValidationAccumulator:
+    """Stitch patch probabilities onto one pair's grid and score each pixel once.
+
+    Overlapping predictions are averaged. A pixel counts as valid when at least
+    one contributing patch marked it valid; the mean is taken over the patches
+    that did, so a pixel is never dropped because one patch had a border halo.
+    """
+
+    def __init__(self, pair, shape, label_path, max_pixels=130_000_000):
+        self.pair = str(pair)
+        self.shape = (int(shape[0]), int(shape[1]))
+        if self.shape[0] * self.shape[1] > int(max_pixels):
+            raise ValueError(
+                "validation grid %dx%d exceeds the %d pixel budget"
+                % (self.shape[0], self.shape[1], max_pixels))
+        self.label_path = label_path
+        self.total = np.zeros(self.shape, dtype=np.float32)
+        self.count = np.zeros(self.shape, dtype=np.uint8)
+
+    def add(self, row_off, col_off, probabilities, valid):
+        rows = _axis_slices(row_off, probabilities.shape[0])
+        cols = _axis_slices(col_off, probabilities.shape[1])
+        valid = np.asarray(valid, dtype=bool)
+        if valid.shape != probabilities.shape:
+            raise ValueError("valid mask shape does not match the patch")
+        if rows.stop > self.shape[0] or cols.stop > self.shape[1]:
+            raise ValueError("patch %r falls outside the validation grid" % ((row_off, col_off),))
+        window = (rows, cols)
+        self.total[window] += np.where(valid, probabilities.astype(np.float32), 0.0)
+        self.count[window] += valid.astype(np.uint8)
+
+    @property
+    def covered_pixels(self):
+        return int((self.count > 0).sum())
+
+    def finalize(self):
+        """Return (scores, labels) for every reviewed pixel, exactly once."""
+        covered = self.count > 0
+        n = int(covered.sum())
+        if n == 0:
+            return np.empty(0, dtype=np.float32), np.empty(0, dtype=np.int64)
+        rows = np.flatnonzero(covered.any(axis=1))
+        cols = np.flatnonzero(covered.any(axis=0))
+        r0, r1 = int(rows[0]), int(rows[-1]) + 1
+        c0, c1 = int(cols[0]), int(cols[-1]) + 1
+        with rasterio.open(self.label_path) as ds:
+            labels = ds.read(1, window=Window(c0, r0, c1 - c0, r1 - r0))
+        sub_covered = covered[r0:r1, c0:c1]
+        sub_total = self.total[r0:r1, c0:c1]
+        sub_count = self.count[r0:r1, c0:c1]
+        scores = (sub_total[sub_covered] / sub_count[sub_covered]).astype(np.float32)
+        truth = labels[sub_covered].astype(np.int64)
+        if not np.all(np.isin(truth, (0, 1))):
+            raise ValueError("reviewed pixels must carry a 0 or 1 label")
+        return scores, truth
+
+
+def unique_validation_metrics(scores, labels, threshold=0.5):
+    """Ranking and threshold metrics over unique reviewed pixels."""
+    scores = np.asarray(scores)
+    labels = np.asarray(labels)
+    if scores.shape != labels.shape:
+        raise ValueError("scores and labels must have the same length")
+    result: dict = {
+        "unique_valid_pixels": int(scores.size),
+        "unique_positive_pixels": int((labels == 1).sum()),
+    }
+    if scores.size == 0:
+        result.update({"ap": float("nan"), "auc": float("nan"),
+                       "precision": float("nan"), "recall": float("nan"),
+                       "f1": float("nan"), "iou": float("nan"),
+                       "tp": 0.0, "fp": 0.0, "fn": 0.0, "tn": 0.0})
+        return result
+    pred = scores >= threshold
+    truth = labels == 1
+    counts = metrics_from_counts(int((pred & truth).sum()), int((pred & ~truth).sum()),
+                                 int((~pred & truth).sum()), int((~pred & ~truth).sum()))
+    result.update(counts)
+    result["ap"] = average_precision(labels, scores)
+    result["auc"] = roc_auc(labels, scores)
+    return result
+
+
+def evaluate_unique(model, loader, device, threshold=0.5, criterion=None,
+                    max_batches=0):
+    """Run a validation loader and return metrics over unique pixels.
+
+    The loader must iterate samples that carry ``pair``, ``row_off``,
+    ``col_off``, ``label_path`` and the patch tensors. Patches of one pair must
+    arrive consecutively, which holds for ``shuffle=False`` over an index that
+    is grouped by pair.
+
+    When ``criterion`` is given, the mean patch loss is returned as ``loss``.
+    That keeps the loss patch-weighted, which is what training optimises, while
+    every reported metric is computed once per reviewed pixel.
+    """
+    import torch
+
+    model.eval()
+    accumulators = {}
+    collected = {}
+    n_patches = 0
+    total_loss = 0.0
+    n_samples = 0
+    with torch.no_grad():
+        for batch_index, batch in enumerate(loader):
+            if max_batches and batch_index >= max_batches:
+                break
+            x1 = batch["image1"].to(device)
+            x2 = batch["image2"].to(device)
+            logits = model(x1, x2)
+            if criterion is not None:
+                target = batch["mask"].to(device, non_blocking=True).float().unsqueeze(1)
+                valid_t = batch.get("valid_mask")
+                if valid_t is None:
+                    valid_t = torch.ones_like(target, dtype=torch.bool)
+                else:
