@@ -0,0 +1,91 @@
+"""Render the technical report from Markdown to PDF.
+
+The report is written once, in `docs/report.md`, and rendered from that file.
+Nothing is retyped for the PDF, so the two cannot drift.
+
+Table support comes from the mistune table plugin; page styling is CSS for
+WeasyPrint. Output is never overwritten.
+"""
+
+import argparse
+import os
+import sys
+
+import mistune
+from weasyprint import HTML
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+PAGE_CSS = """
+@page {
+  size: A4;
+  margin: 18mm 16mm 20mm 16mm;
+  @bottom-center {
+    content: counter(page) " / " counter(pages);
+    font-size: 8pt;
+    color: #666;
+  }
+}
+body {
+  font-family: "DejaVu Serif", Georgia, serif;
+  font-size: 9.6pt;
+  line-height: 1.42;
+  color: #111;
+}
+h1 { font-size: 17pt; margin: 0 0 4mm 0; border-bottom: 0.6pt solid #999; padding-bottom: 2mm; }
+h2 { font-size: 12.5pt; margin: 7mm 0 2mm 0; page-break-after: avoid; }
+h3 { font-size: 10.5pt; margin: 5mm 0 1.5mm 0; page-break-after: avoid; }
+p, li { text-align: justify; }
+table {
+  border-collapse: collapse;
+  width: 100%;
+  margin: 2mm 0 4mm 0;
+  font-size: 8.2pt;
+  page-break-inside: avoid;
+}
+th, td { border: 0.4pt solid #bbb; padding: 1.2mm 1.6mm; text-align: left; vertical-align: top; }
+th { background: #efefef; font-weight: bold; }
+code { font-family: "DejaVu Sans Mono", monospace; font-size: 8.4pt; }
+pre {
+  font-family: "DejaVu Sans Mono", monospace;
+  font-size: 7.8pt;
+  background: #f6f6f6;
+  border-left: 2pt solid #bbb;
+  padding: 2mm 3mm;
+  white-space: pre-wrap;
+  page-break-inside: avoid;
+}
+blockquote { margin: 3mm 0 3mm 4mm; padding-left: 4mm; border-left: 2pt solid #ccc; color: #333; }
+hr { border: none; border-top: 0.5pt solid #aaa; margin: 5mm 0; }
+"""
+
+
+def render(markdown_path, pdf_path, title):
+    with open(markdown_path, encoding="utf-8") as handle:
+        text = handle.read()
+    body = mistune.create_markdown(plugins=["table", "strikethrough"])(text)
+    html = (
+        "<!doctype html><html><head><meta charset='utf-8'>"
+        "<title>%s</title><style>%s</style></head><body>%s</body></html>"
+        % (title, PAGE_CSS, body))
+    HTML(string=html, base_url=os.path.dirname(markdown_path)).write_pdf(pdf_path)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--input", default=os.path.join(ROOT, "docs", "report.md"))
+    parser.add_argument("--output", default=os.path.join(ROOT, "docs", "report.pdf"))
+    parser.add_argument("--title", default="TerraShift — technical report")
+    args = parser.parse_args()
+
+    if not os.path.isfile(args.input):
+        parser.error("input not found: %s" % args.input)
+    if os.path.exists(args.output):
+        parser.error("refusing to overwrite %s" % args.output)
+
+    render(args.input, args.output, args.title)
+    print("wrote", args.output, os.path.getsize(args.output), "bytes")
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/build_review_queue.py b/scripts/build_review_queue.py
new file mode 100644
index 0000000..6d65aa8
--- /dev/null
+++ b/scripts/build_review_queue.py
@@ -0,0 +1,241 @@
+"""Build a QGIS review queue from the candidate layers and the partitions.
+
+Output is one CSV row per candidate, ordered by pair and partition, with a
+review order inside each group. No decision is made here: the human fields are
+written empty and every row starts as ``unreviewed``.
+
+The partition assignment is read from the 20 m partition raster, window by
+window, so a candidate that spans more than one split is detected rather than
+guessed from its centroid. Codes follow ``scripts/prepare_local_partitions.py``:
+0 is the 500 m guard band, 1 train, 2 validation, 3 test.
+
+Usage:
+
+    python scripts/build_review_queue.py \
+        --output-dir review/manual_review_v1
+"""
+
+import argparse
+import csv
+import json
+import os
+import sys
+
+import numpy as np
+import rasterio
+from pyproj import Transformer
+from rasterio.features import geometry_mask
+from rasterio.windows import Window, from_bounds
+import shapely
+from shapely.geometry import shape as shapely_shape
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+
+CANDIDATE_DIR = os.path.join(ROOT, "outputs", "labels", "v2_observation_valid")
+PARTITION_DIR = os.path.join(ROOT, "outputs", "partitions_v2_observation_valid")
+DEFAULT_OUT = os.path.join(ROOT, "review", "manual_review_v1")
+
+SPLIT_CODES = {1: "train", 2: "validation", 3: "test"}
+GUARD_CODE = 0
+PIXEL_AREA_M2 = 20.0 * 20.0
+PARTITION_ORDER = {"train": 0, "validation": 1, "test": 2, "guard": 3, "mixed": 4}
+
+FIELDS = [
+    "candidate_id", "pair", "component_id", "partition", "n_partitions",
+    "partition_codes", "crosses_partition_boundary", "touches_guard_band",
+    "guard_fraction", "bbox_width_px_20m", "bbox_height_px_20m",
+    "bbox_width_m", "bbox_height_m", "bbox_area_m2",
+    "component_area_px_20m", "component_area_m2",
+    "mean_score", "max_score", "score_threshold", "priority_percentile",
+    "centroid_lon", "centroid_lat", "centroid_easting", "centroid_northing",
+    "review_order", "review_status", "human_decision", "evidence", "confidence",
+    "note",
+]
+
+
+def partition_window(dataset, bounds):
+    """The raster window covering a geometry's bounds, clipped to the raster."""
+    window = from_bounds(*bounds, transform=dataset.transform)
+    window = window.round_offsets().round_lengths()
+    col0 = max(0, int(window.col_off))
+    row0 = max(0, int(window.row_off))
+    col1 = min(dataset.width, int(window.col_off + window.width))
+    row1 = min(dataset.height, int(window.row_off + window.height))
+    if col1 <= col0 or row1 <= row0:
+        return None
+    return Window(col0, row0, col1 - col0, row1 - row0)
+
+
+def classify_partition(codes, total):
+    """Partition label and flags from the codes under one polygon.
+
+    Returns ``(partition, crosses_boundary, touches_guard, guard_fraction)``.
+    ``mixed`` means the polygon covers pixels from more than one of train,
+    validation and test, which the rasterizer refuses.
+    """
+    present_splits = sorted({SPLIT_CODES[c] for c in codes if c in SPLIT_CODES})
+    guard_pixels = int((codes == GUARD_CODE).sum())
+    guard_fraction = guard_pixels / total if total else 0.0
+    touches_guard = guard_pixels > 0
+    crosses = len(present_splits) > 1
+
+    if not present_splits:
+        return "guard", False, touches_guard, guard_fraction
+    if crosses:
+        return "mixed", True, touches_guard, guard_fraction
+    return present_splits[0], False, touches_guard, guard_fraction
+
+
+def candidate_rows(pair, candidates, partition_path):
+    """Rows for one pair, without the review order (assigned later)."""
+    transformer = Transformer.from_crs("EPSG:4326", "EPSG:32643", always_xy=True)
+    rows = []
+    with rasterio.open(partition_path) as dataset:
+        for feature in candidates["features"]:
+            props = feature["properties"]
+            geometry = shapely_shape(feature["geometry"])
+            geometry_m = shapely.transform(
+                geometry,
+                lambda coords: np.column_stack(transformer.transform(coords[:, 0],
+                                                                     coords[:, 1])))
+
+            window = partition_window(dataset, geometry_m.bounds)
+            if window is None:
+                partition, crosses, touches_guard, guard_fraction = (
+                    "outside", False, False, 0.0)
+                codes = np.zeros(0, dtype=np.uint8)
+            else:
+                data = dataset.read(1, window=window)
+                transform = dataset.window_transform(window)
+                inside = geometry_mask([geometry_m], out_shape=data.shape,
+                                       transform=transform, invert=True)
+                codes = data[inside]
+                partition, crosses, touches_guard, guard_fraction = classify_partition(
+                    codes, codes.size)
+
+            minx, miny, maxx, maxy = geometry_m.bounds
+            centroid = geometry_m.centroid
+            lon, lat = Transformer.from_crs("EPSG:32643", "EPSG:4326",
+                                            always_xy=True).transform(centroid.x, centroid.y)
+            pixels = props.get("area_px_20m")
+            rows.append({
+                "candidate_id": props["candidate_id"],
+                "pair": props["pair"],
+                "component_id": props["component_id"],
+                "partition": partition,
+                "n_partitions": len({c for c in codes if c in SPLIT_CODES}),
+                "partition_codes": "|".join(str(int(c)) for c in np.unique(codes))
+                                   if codes.size else "",
+                "crosses_partition_boundary": crosses,
+                "touches_guard_band": touches_guard,
+                "guard_fraction": round(guard_fraction, 4),
+                "bbox_width_px_20m": int(round((maxx - minx) / 20.0)),
+                "bbox_height_px_20m": int(round((maxy - miny) / 20.0)),
+                "bbox_width_m": round(maxx - minx, 1),
+                "bbox_height_m": round(maxy - miny, 1),
+                "bbox_area_m2": round((maxx - minx) * (maxy - miny), 1),
+                "component_area_px_20m": int(pixels) if pixels is not None else "",
+                "component_area_m2": round(pixels * PIXEL_AREA_M2, 1) if pixels else "",
+                "mean_score": round(float(props["mean_score"]), 4),
+                "max_score": round(float(props["max_score"]), 4),
+                "score_threshold": props.get("score_threshold"),
+                "priority_percentile": props.get("priority_percentile"),
+                "centroid_lon": round(lon, 7),
+                "centroid_lat": round(lat, 7),
+                "centroid_easting": round(centroid.x, 2),
+                "centroid_northing": round(centroid.y, 2),
+                "review_order": "",
+                "review_status": "unreviewed",
+                "human_decision": "",
+                "evidence": "",
+                "confidence": "",
+                "note": "",
+            })
+    return rows
+
+
+def order_rows(rows):
+    """Review order inside each (pair, partition) group.
+
+    Flags first, because a polygon that straddles a boundary has to be split or
+    dropped before it can be labelled at all. Then largest component first, so
+    the reviewer starts with clearest evidence, then highest score.
+    """
+    rows.sort(key=lambda row: (row["pair"], PARTITION_ORDER.get(row["partition"], 9),
+                               not (row["crosses_partition_boundary"]
+                                    or row["touches_guard_band"]),
+                               -int(row["component_area_px_20m"] or 0),
+                               -float(row["max_score"])))
+    counter = {}
+    for row in rows:
+        key = (row["pair"], row["partition"])
+        counter[key] = counter.get(key, 0) + 1
+        row["review_order"] = counter[key]
+    return rows
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--candidate-dir", default=CANDIDATE_DIR)
+    parser.add_argument("--partition-dir", default=PARTITION_DIR)
+    parser.add_argument("--output-dir", default=DEFAULT_OUT)
+    args = parser.parse_args()
+
+    output_csv = os.path.join(args.output_dir, "review_queue.csv")
+    output_json = os.path.join(args.output_dir, "review_queue_summary.json")
+    for path in (output_csv, output_json):
+        if os.path.exists(path):
+            parser.error("refusing to overwrite %s" % path)
+
+    rows = []
+    for pair in ("A", "B"):
+        candidate_path = os.path.join(
+            args.candidate_dir, "review_candidates_%s_p99_9.geojson" % pair)
+        partition_path = os.path.join(
+            args.partition_dir, "pair_%s_partition_20m.tif" % pair)
+        for path in (candidate_path, partition_path):
+            if not os.path.isfile(path):
+                parser.error("missing input: %s" % path)
+        with open(candidate_path) as handle:
+            candidates = json.load(handle)
+        rows.extend(candidate_rows(pair, candidates, partition_path))
+        print("%s: %d candidates" % (pair, len(candidates["features"])))
+
+    order_rows(rows)
+    os.makedirs(args.output_dir, exist_ok=True)
+    with open(output_csv, "w", newline="") as handle:
+        writer = csv.DictWriter(handle, fieldnames=FIELDS)
+        writer.writeheader()
+        writer.writerows(rows)
+
+    counts = {}
+    for row in rows:
+        key = "%s/%s" % (row["pair"], row["partition"])
+        counts[key] = counts.get(key, 0) + 1
+    flagged_cross = [r["candidate_id"] for r in rows if r["crosses_partition_boundary"]]
+    flagged_guard = [r["candidate_id"] for r in rows if r["touches_guard_band"]]
+    summary = {
+        "rows": len(rows),
+        "counts_by_pair_and_partition": dict(sorted(counts.items())),
+        "crosses_partition_boundary": flagged_cross,
+        "touches_guard_band": flagged_guard,
+        "fields": FIELDS,
+        "status": "review_queue_not_labels",
+        "note": ("Every row starts unreviewed with empty human fields. Nothing "
+                 "here is ground truth, and the rasterizer still has the final say."),
+    }
+    with open(output_json, "w") as handle:
+        json.dump(summary, handle, indent=1)
+
+    print("\nrows written:", len(rows))
+    for key, value in sorted(counts.items()):
+        print("  %-18s %d" % (key, value))
+    print("crosses a partition boundary:", len(flagged_cross), flagged_cross)
+    print("touches the guard band:", len(flagged_guard), flagged_guard)
+    print("\nwrote", output_csv)
+    print("wrote", output_json)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/build_validation_review.py b/scripts/build_validation_review.py
new file mode 100644
index 0000000..e2f3efe
--- /dev/null
+++ b/scripts/build_validation_review.py
@@ -0,0 +1,192 @@
+"""Build the Pair A validation-split review package.
+
+Three layers for reviewing the validation stripe in QGIS:
+
+1. the candidate rectangles that fall in the validation partition, with the
+   class already assigned to them, if any;
+2. the annotations that live in the validation partition;
+3. proposal areas: places inside the validation partition where the classical
+   change score passes the 99th percentile but which are **not** covered by any
+   existing annotation or candidate rectangle. These are suggestions for a human
+   to look at, not detections and not labels.
+
+    python scripts/build_validation_review.py --pair A \
+        --output-dir outputs/labels/pair_a_qa/validation_review
+"""
+
+import argparse
+import csv
+import json
+import os
+import sys
+
+import numpy as np
+import rasterio
+from pyproj import Transformer
+from rasterio.features import shapes as raster_shapes
+from rasterio.features import rasterize
+from scipy import ndimage as ndi
+from shapely.geometry import shape
+from shapely.ops import transform as shapely_transform
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+
+PARTITION_NAMES = {1: "train", 2: "validation", 3: "test"}
+MIN_PROPOSAL_PX = 4
+
+
+def load_queue(path, pair):
+    with open(path, newline="") as handle:
+        return [row for row in csv.DictReader(handle)
+                if row["pair"] == pair and row["partition"] == "validation"]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--pair", default="A")
+    parser.add_argument("--labels", default="labels/manual_labels_A.geojson")
+    parser.add_argument("--queue", default="review/manual_review_v1/review_queue.csv")
+    parser.add_argument("--candidates",
+                        default="outputs/labels/v2_observation_valid/review_candidates_A_p99_9.geojson")
+    parser.add_argument("--audit", default="outputs/labels/pair_a_provisional/manual_labels_A_audit.csv")
+    parser.add_argument("--score", default="outputs/baseline_v2_observation_valid/change_score_A.tif")
+    parser.add_argument("--partition", default="outputs/partitions_v2_observation_valid/pair_A_partition_20m.tif")
+    parser.add_argument("--percentile", type=float, default=99.0)
+    parser.add_argument("--output-dir", required=True)
+    args = parser.parse_args()
+
+    if os.path.isdir(args.output_dir) and os.listdir(args.output_dir):
+        raise SystemExit("refusing to write into a non-empty %s" % args.output_dir)
+    os.makedirs(args.output_dir, exist_ok=True)
+
+    # --- 1. candidates in the validation partition
+    queue = load_queue(args.queue, args.pair)
+    annotated = {}
+    with open(args.audit, newline="") as handle:
+        for row in csv.DictReader(handle):
+            if row.get("split") == "validation":
+                annotated[row["record_id"]] = row
+
+    with open(args.candidates) as handle:
+        candidates = json.load(handle)
+    by_id = {f["properties"]["candidate_id"]: f for f in candidates["features"]}
+    validation_candidates = []
+    for row in queue:
+        feature = by_id.get(row["candidate_id"])
+        if feature is None:
+            continue
+        props = dict(feature["properties"])
+        props.update({"queue_partition": "validation",
+                      "annotated_as": annotated.get(row["candidate_id"], {}).get("label_class", ""),
+                      "review_order": row["review_order"]})
+        validation_candidates.append({"type": "Feature", "properties": props,
+                                      "geometry": feature["geometry"]})
+
+    candidate_path = os.path.join(args.output_dir, "validation_candidates.geojson")
+    with open(candidate_path, "w") as handle:
+        json.dump({"type": "FeatureCollection", "name": "validation_candidates",
+                   "features": validation_candidates}, handle, indent=1)
+
+    # --- 2. annotations already in the validation partition
+    with open(args.labels) as handle:
+        labels = json.load(handle)
+    annotation_features = [f for f in labels["features"]
+                           if f["properties"]["record_id"] in annotated]
+    annotation_path = os.path.join(args.output_dir, "validation_annotations.geojson")
+    with open(annotation_path, "w") as handle:
+        json.dump({"type": "FeatureCollection", "name": "validation_annotations",
+                   "features": annotation_features}, handle, indent=1)
+
+    # --- 3. proposal areas: score tail inside validation, not already reviewed
+    with rasterio.open(args.score) as score_src, rasterio.open(args.partition) as part_src:
+        score = score_src.read(1, masked=True).filled(np.nan)
+        partition = part_src.read(1)
+        transform, crs = score_src.transform, score_src.crs
+        if score.shape != partition.shape:
+            raise SystemExit("score and partition rasters are not on the same grid")
+
+        valid = np.isfinite(score)
+        threshold = float(np.percentile(score[valid], args.percentile))
+        in_validation = partition == 2
+        proposal = (score > threshold) & valid & in_validation
+
+        # remove anything already annotated or already offered as a candidate
+        reviewed = np.zeros(score.shape, dtype=bool)
+        if annotation_features:
+            geoms = [shape(f["geometry"]) for f in annotation_features]
+            to_metric = Transformer.from_crs("EPSG:4326", crs.to_string(), always_xy=True)
+            geoms = [shapely_transform(to_metric.transform, g) for g in geoms]
+            reviewed |= rasterize([(g.__geo_interface__, 1) for g in geoms],
+                                  out_shape=score.shape, transform=transform,
+                                  fill=0, dtype="uint8").astype(bool)
+        if validation_candidates:
+            reviewed |= rasterize([(f["geometry"], 1) for f in validation_candidates],
+                                  out_shape=score.shape, transform=transform,
+                                  fill=0, dtype="uint8").astype(bool)
+        proposal &= ~reviewed
+
+        labels_map, count = ndi.label(proposal)
+        sizes = np.bincount(labels_map.ravel(), minlength=count + 1)
+        keep = sizes >= MIN_PROPOSAL_PX
+        keep[0] = False
+        cleaned = keep[labels_map]
+
+        to_wgs84 = Transformer.from_crs(crs.to_string(), "EPSG:4326", always_xy=True)
+        features = []
+        for geom, value in raster_shapes(cleaned.astype("uint8"), mask=cleaned,
+                                         transform=transform):
+            polygon = shape(geom)
+            area_m2 = float(polygon.area)
+            inside = score[cleaned & rasterize(
+                [(geom, 1)], out_shape=score.shape, transform=transform,
+                fill=0, dtype="uint8").astype(bool)]
+            inside = inside[np.isfinite(inside)]
+            features.append({
+                "type": "Feature",
+                "properties": {
+                    "pair": args.pair,
+                    "area_px_20m": int(round(area_m2 / 400.0)),
+                    "area_m2": round(area_m2, 1),
+                    "max_score": round(float(inside.max()), 3) if inside.size else None,
+                    "mean_score": round(float(inside.mean()), 3) if inside.size else None,
+                    "status": "proposal_only_not_a_label",
+                },
+                "geometry": json.loads(json.dumps(
+                    shapely_transform(to_wgs84.transform, polygon).__geo_interface__)),
+            })
+        proposal_path = os.path.join(args.output_dir, "validation_proposal_areas.geojson")
+        with open(proposal_path, "w") as handle:
+            json.dump({"type": "FeatureCollection", "name": "validation_proposal_areas",
+                       "features": features}, handle, indent=1)
+
+    summary = {
+        "pair": args.pair,
+        "validation_candidates": len(validation_candidates),
+        "validation_annotations": len(annotation_features),
+        "proposal_areas": len(features),
+        "proposal_threshold_percentile": args.percentile,
+        "proposal_threshold_value": threshold,
+        "proposal_pixels": int(cleaned.sum()),
+        "annotation_classes": {},
+        "layers": {"candidates": os.path.abspath(candidate_path),
+                   "annotations": os.path.abspath(annotation_path),
+                   "proposals": os.path.abspath(proposal_path)},
+    }
+    for row in annotated.values():
+        summary["annotation_classes"][row["label_class"]] = \
+            summary["annotation_classes"].get(row["label_class"], 0) + 1
+    with open(os.path.join(args.output_dir, "validation_review.json"), "w") as handle:
+        json.dump(summary, handle, indent=1)
+
+    print("validation candidates:", len(validation_candidates))
+    print("validation annotations:", len(annotation_features), summary["annotation_classes"])
+    print("proposal areas (score > p%.1f, not already reviewed): %d covering %d px"
+          % (args.percentile, len(features), int(cleaned.sum())))
+    print("\nwrote", candidate_path)
+    print("wrote", annotation_path)
+    print("wrote", proposal_path)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/compare_patch_sampling.py b/scripts/compare_patch_sampling.py
new file mode 100644
index 0000000..dc71636
--- /dev/null
+++ b/scripts/compare_patch_sampling.py
@@ -0,0 +1,210 @@
+"""Compare training patch sampling strategies on the Pair A annotations.
+
+The configured labelled-fraction threshold (0.05) produces no Pair A patches,
+because annotations cover 0.0147 % of the tile. This measures what each
+alternative would actually yield, before anything is baked into the config.
+
+Strategies compared:
+
+    grid        every grid-aligned window whose reviewed fraction clears a
+                threshold, as the indexer does today;
+    centred     one window centred on each annotation centroid;
+    balanced    grid windows split into change-containing and no_change-only
+                pools, sampled to a 1:1 ratio.
+
+For each: unique patches, patches per split, labelled pixels per class, spatial
+spread, and how much the selected windows overlap each other.
+
+    python scripts/compare_patch_sampling.py \
+        --labels outputs/labels/pair_a_provisional/manual_labels_A.tif \
+        --partition outputs/partitions_v2_observation_valid/pair_A_partition_10m.tif \
+        --output outputs/labels/pair_a_qa/patch_sampling.json
+"""
+
+import argparse
+import json
+import os
+import sys
+
+import numpy as np
+import rasterio
+from scipy import ndimage as ndi
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+
+from data.oscd_original import patch_origins
+
+SPLIT_NAMES = {1: "train", 2: "validation", 3: "test"}
+THRESHOLDS = [0.05, 0.02, 0.01, 0.005, 0.002, 0.001]
+PATCH_SIZES = [256, 128]
+
+
+def window_stats(label, partition, r0, c0, size):
+    """Class counts and split id for one window, or None if it spans splits."""
+    part = partition[r0:r0 + size, c0:c0 + size]
+    if part.shape != (size, size):
+        return None
+    codes = np.unique(part)
+    if codes.size != 1 or codes[0] == 0:
+        return None
+    lab = label[r0:r0 + size, c0:c0 + size]
+    reviewed = lab != 255
+    return {
+        "split": int(codes[0]),
+        "r0": int(r0), "c0": int(c0), "size": int(size),
+        "reviewed": int(reviewed.sum()),
+        "change": int((lab == 1).sum()),
+        "no_change": int((lab == 0).sum()),
+        "reviewed_fraction": float(reviewed.mean()),
+    }
+
+
+def grid_pool(label, partition, size, stride, include_test=False):
+    """Split-contained windows, mirroring the indexer: test is excluded by default."""
+    pool = []
+    for r0 in patch_origins(label.shape[0], size, stride):
+        for c0 in patch_origins(label.shape[1], size, stride):
+            stats = window_stats(label, partition, r0, c0, size)
+            if stats is None:
+                continue
+            if stats["split"] == 3 and not include_test:
+                continue
+            pool.append(stats)
+    return pool
+
+
+def select_by_threshold(pool, threshold):
+    return [p for p in pool if p["reviewed_fraction"] >= threshold]
+
+
+def spatial_spread(patches):
+    if not patches:
+        return {"count": 0}
+    rows = np.array([p["r0"] for p in patches])
+    cols = np.array([p["c0"] for p in patches])
+    centroids = np.column_stack([rows + np.array([p["size"] for p in patches]) / 2,
+                                 cols + np.array([p["size"] for p in patches]) / 2])
+    if len(patches) == 1:
+        nearest = [float("nan")]
+    else:
+        nearest = []
+        for index in range(len(centroids)):
+            others = np.delete(centroids, index, axis=0)
+            distances = np.hypot(*(others - centroids[index]).T)
+            nearest.append(float(distances.min()))
+    return {
+        "count": len(patches),
+        "row_span": [int(rows.min()), int(rows.max())],
+        "col_span": [int(cols.min()), int(cols.max())],
+        "median_nearest_neighbour_px": float(np.nanmedian(nearest)) if len(patches) > 1 else None,
+    }
+
+
+def coverage(patches, shape):
+    """Fraction of the covered area that is covered by more than one window."""
+    counts = np.zeros(shape, dtype=np.int16)
+    for p in patches:
+        counts[p["r0"]:p["r0"] + p["size"], p["c0"]:p["c0"] + p["size"]] += 1
+    covered = counts > 0
+    if not covered.any():
+        return {"covered_px": 0, "multi_covered_fraction": 0.0}
+    return {
+        "covered_px": int(covered.sum()),
+        "multi_covered_fraction": round(float((counts > 1).sum() / covered.sum()), 4),
+    }
+
+
+def summarise(name, patches, shape):
+    per_split = {name_: [p for p in patches if p["split"] == code]
+                 for code, name_ in SPLIT_NAMES.items()}
+    return {
+        "strategy": name,
+        "patches": len(patches),
+        "per_split": {k: len(v) for k, v in per_split.items()},
+        "change_px": int(sum(p["change"] for p in patches)),
+        "no_change_px": int(sum(p["no_change"] for p in patches)),
+        "patches_with_change": int(sum(1 for p in patches if p["change"] > 0)),
+        "patches_without_change": int(sum(1 for p in patches if p["change"] == 0)),
+        "spread": spatial_spread(patches),
+        "coverage": coverage(patches, shape),
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--labels", required=True)
+    parser.add_argument("--partition", required=True)
+    parser.add_argument("--output", required=True)
+    args = parser.parse_args()
+
+    if os.path.exists(args.output):
+        raise SystemExit("refusing to overwrite %s" % args.output)
+
+    with rasterio.open(args.labels) as src:
+        label = src.read(1)
+    with rasterio.open(args.partition) as src:
+        partition = src.read(1)
+    if label.shape != partition.shape:
+        raise SystemExit("labels and partition are not on the same grid")
+    shape = label.shape
+    reviewed_total = int((label != 255).sum())
+    print("tile %s, reviewed %d px (%.4f%%)" % (shape, reviewed_total,
+                                                100 * reviewed_total / label.size))
+
+    report = {"tile": list(shape), "reviewed_px": reviewed_total,
+              "reviewed_fraction": reviewed_total / label.size, "results": {}}
+
+    for size in PATCH_SIZES:
+        stride = size // 2
+        pool = grid_pool(label, partition, size, stride)
+        print("patch %d stride %d: %d split-contained windows" % (size, stride, len(pool)))
+        for threshold in THRESHOLDS:
+            selected = select_by_threshold(pool, threshold)
+            key = "grid_%d_thr%.3f" % (size, threshold)
+            report["results"][key] = summarise(key, selected, shape)
+            print("  threshold %.3f -> %4d patches (%d with change)"
+                  % (threshold, len(selected),
+                     sum(1 for p in selected if p["change"] > 0)))
+
+        # balanced: equal numbers of change-containing and no_change-only windows,
+        # taken largest-reviewed-first so the selection is deterministic.
+        with_change = sorted([p for p in pool if p["change"] > 0],
+                             key=lambda p: (-p["reviewed"], p["r0"], p["c0"]))
+        without = sorted([p for p in pool if p["change"] == 0],
+                         key=lambda p: (-p["reviewed"], p["r0"], p["c0"]))
+        take = min(len(with_change), len(without))
+        balanced = with_change[:take] + without[:take]
+        key = "balanced_%d" % size
+        report["results"][key] = summarise(key, balanced, shape)
+        print("  balanced -> %d patches (%d + %d)" % (len(balanced), take, take))
+
+    # annotation-centred: one window per annotation centroid, snapped to the grid
+    centres = []
+    labels_map, count = ndi.label(label == 1)
+    for index in range(1, count + 1):
+        rows, cols = np.where(labels_map == index)
+        if rows.size == 0:
+            continue
+        centres.append((int(rows.mean()), int(cols.mean())))
+    for size in PATCH_SIZES:
+        patches = []
+        for row, col in centres:
+            r0 = max(0, min(shape[0] - size, row - size // 2))
+            c0 = max(0, min(shape[1] - size, col - size // 2))
+            stats = window_stats(label, partition, r0, c0, size)
+            if stats is not None and stats["split"] != 3:
+                patches.append(stats)
+        key = "centred_%d" % size
+        report["results"][key] = summarise(key, patches, shape)
+        print("  annotation-centred %d -> %d patches from %d change components"
+              % (size, len(patches), len(centres)))
+
+    os.makedirs(os.path.dirname(os.path.abspath(args.output)), exist_ok=True)
+    with open(args.output, "w") as handle:
+        json.dump(report, handle, indent=1)
+    print("\nwrote", args.output)
+
+
+if __name__ == "__main__":
+    main()
